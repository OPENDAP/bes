<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:dmrpp="http://xml.opendap.org/dap/dmrpp/1.0.0#"
    targetNamespace="http://xml.opendap.org/dap/dmrpp/1.0.0#"
    elementFormDefault="qualified"
    attributeFormDefault="unqualified"
    version="1.1">

    <!-- generate reference documentation using xs3p.xsl using the command:
     xsltproc ../tools/xs3p/xs3p.xsl dmrpp.xsd > ../docs/dmrpp-reference.html -->

    <xs:annotation>
        <xs:documentation>
            DMR++ extensions to the DAP4 DMR. Schema version 1.1, 19 November 2026.

            The namespace URI is unchanged ("http://xml.opendap.org/dap/dmrpp/1.0.0#") so that existing DMR++
            documents remain in this namespace. Only the schema 'version' attribute changes.

            This schema describes DMR++ as it is written and read today (see the DMR++ descriptive specification,
            Draft 0.2). Behaviors of the Hyrax DMZ parser that a generic XML processor would not expect are marked
            "Hyrax deviation".

            Changes from version 1.0:
            - chunkPositionInArray: defined as the element index of the chunk's first element (not a chunk-space
              index), and made optional (it is absent for contiguous data).
            - Corrected the documentation of 'chunks', 'chunk' and 'chunkDimensionSizes': 'chunks' is used for
              contiguous data too; no 'chunk' children means every value is a fill value; 'chunkDimensionSizes'
              may be present or absent when there are no chunks.
            - compressionType: removed the claim that chunks may override it; added a filter vocabulary
              (deflate, shuffle, fletcher32, lzw, tiffpred:p:spp:epr).
            - deflateLevel: levels restricted to 0-9.
            - vlsa: added the 's' (compressed size) attribute to 'v'; accepts the unprefixed 'v' that all current
              documents use (it inherits the DAP4 default namespace) as well as 'dmrpp:v'.
            - chunk and block: accept 'dmrpp:trust', 'dmrpp:s3' and 'dmrpp:s3credentials', which Hyrax injects
              when it replaces placeholder URLs.
            - DIO: restricted to the value "off".
            - dmrpp:trust: removed the declared default (absence means "not trusted"); documented that Hyrax
              recognizes only the literal "true" for xs:boolean attributes.
            - Documented the content encodings of 'compact', 'missingdata', 'specialstructuredata' and 'v', the
              syntax of 'fillValue', the meaning of a missing 'structOffset', linked-block chunks, the single-block
              legacy form, and the direction of the 'fm' bits.
            - Corrected the descriptions of 'missingdata', 'specialstructuredata', 'FixedLengthStringArray',
              'LBChunk', 'DIO' and 'fm'.
        </xs:documentation>
    </xs:annotation>

    <!-- ==========
         Simple types
         ========== -->

    <!-- Little / big endian byte order -->
    <xs:simpleType name="ByteOrder">
        <xs:restriction base="xs:string">
            <xs:enumeration value="LE" />
            <xs:enumeration value="BE" />
        </xs:restriction>
    </xs:simpleType>

    <!-- Unsigned 64-bit values (offsets, sizes) -->
    <xs:simpleType name="UnsignedLong">
        <xs:restriction base="xs:unsignedLong" />
    </xs:simpleType>

    <!-- Space-separated list of non-negative integers (chunk dimension sizes) -->
    <xs:simpleType name="IndexList">
        <xs:list itemType="xs:unsignedLong" />
    </xs:simpleType>

    <!-- Bracketed, comma-separated element indices, e.g., [0,50] or [1910,0] -->
    <xs:simpleType name="ChunkPositionInArrayExpr">
        <xs:restriction base="xs:string">
            <xs:pattern value="\[[0-9]+(,[0-9]+)*\]" />
        </xs:restriction>
    </xs:simpleType>

    <!-- One filter name. 'tiffpred' carries its parameters: tiffpred:predictor:samples-per-pixel:elements-per-row -->
    <xs:simpleType name="FilterName">
        <xs:restriction base="xs:token">
            <xs:pattern value="deflate|shuffle|fletcher32|lzw|tiffpred:[0-9]+:[0-9]+:[0-9]+" />
        </xs:restriction>
    </xs:simpleType>

    <!-- Space-separated list of filters, in the order they were applied when the data were written -->
    <xs:simpleType name="FilterList">
        <xs:list itemType="dmrpp:FilterName" />
    </xs:simpleType>

    <!-- One deflate (zlib) compression level -->
    <xs:simpleType name="DeflateLevel">
        <xs:restriction base="xs:nonNegativeInteger">
            <xs:maxInclusive value="9" />
        </xs:restriction>
    </xs:simpleType>

    <!-- Space-separated list of deflate levels -->
    <xs:simpleType name="DeflateLevelList">
        <xs:list itemType="dmrpp:DeflateLevel" />
    </xs:simpleType>

    <!-- Space-separated list of struct member offsets followed by the record size -->
    <xs:simpleType name="StructOffsetList">
        <xs:list itemType="xs:nonNegativeInteger" />
    </xs:simpleType>

    <!-- How fixed-length strings are padded -->
    <xs:simpleType name="PadKind">
        <xs:restriction base="xs:string">
            <xs:enumeration value="null_pad" />
            <xs:enumeration value="null_term" />
            <xs:enumeration value="space_pad" />
            <xs:enumeration value="not_set" />
        </xs:restriction>
    </xs:simpleType>

    <!-- Direct I/O control; only "off" has an effect -->
    <xs:simpleType name="DirectIOSetting">
        <xs:restriction base="xs:string">
            <xs:enumeration value="off" />
        </xs:restriction>
    </xs:simpleType>

    <!-- ==========
         Dataset-level attributes
         ========== -->

    <xs:attribute name="href" type="xs:anyURI">
        <xs:annotation>
            <xs:documentation>
                Location of the data for all data referenced by a 'chunk' or 'block' unless those explicitly provide
                their own 'href' attribute. For example,
                "https://archive.podaac.earthdata.nasa.gov/podaac-ops-cumulus-protected/MUR-JPL-L4-GLOB-v4.1/20260519090000-JPL-L4_GHRSST-SSTfnd-MUR-GLOB-v02.0-fv04.1.nc"

                A value without a scheme ("://") is a path. Hyrax resolves such a path relative to the BES catalog
                root directory, even when it starts with '/', and reads it as a file:// URL.

                Hyrax deviation: a DMR++ may contain the placeholder value "OPeNDAP_DMRpp_DATA_ACCESS_URL" (or, on a
                chunk, "OPeNDAP_DMRpp_MISSING_DATA_ACCESS_URL"). When serving the document, Hyrax replaces the text
                href="PLACEHOLDER" with the data URL and adds dmrpp:s3, dmrpp:s3credentials and dmrpp:trust="true".
                For the MISSING placeholder the suffix "_mvs.h5" is appended to the URLs.
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:attribute name="trust" type="xs:boolean">
        <xs:annotation>
            <xs:documentation>
                The 'dmrpp:trust' attribute has a tortured history. It was originally intended as a hint that URL(s)
                associated with this DMR++ did not need to be vetted using a list of allowed hosts. In its initial use,
                DMR++ _always_ used URLs received from the NASA CMR database, and those URLs were always trusted. The
                attribute thus told the software processing the DMR++ that it could skip vetting the URLs against a
                list of allowed hosts. This attribute should be ignored by most users of the DMR++ documents. Other
                software that interprets these documents should avoid using this for access control decisions.

                When absent, the URL is not trusted. On the Dataset element it applies to dmrpp:href. On a 'chunk' or
                'block' it applies to that element's own 'href'.

                Hyrax deviation: the DMZ parser treats only the literal value "true" as true. Producers should write
                "true" or "false", not "1" or "0".
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:attribute name="version" type="xs:string">
        <xs:annotation>
            <xs:documentation>
                Version of the DMR++ software used to generate this DMR++. For example, "3.21.1" or "3.21.1-1090".

                Hyrax deviation: when this attribute is absent, the DMZ parser treats the document as an "old style"
                DMR++. It then ignores the order of the filters in 'compressionType', removes duplicates, and rebuilds
                the list in the order "shuffle deflate fletcher32" (lists that contain 'lzw' or 'tiffpred' are left
                unchanged). Producers should always write this attribute.
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:attribute name="s3" type="xs:anyURI">
        <xs:annotation>
            <xs:documentation>
                S3 URI for the data, e.g.,
                "s3://podaac-ops-cumulus-protected/MUR-JPL-L4-GLOB-v4.1/20260519090000-JPL-L4_GHRSST-SSTfnd-MUR-GLOB-v02.0-fv04.1.nc".
                If provided, this provides an alternative data source to the 'href' attribute. Hyrax adds this
                attribute when it replaces placeholder URLs; the DMZ parser does not read it.
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:attribute name="s3credentials" type="xs:anyURI">
        <xs:annotation>
            <xs:documentation>
                URI for S3 credentials, e.g., "https://archive.podaac.earthdata.nasa.gov/s3credentials". If provided,
                this provides the necessary credentials to access the S3 URI specified in the 's3' attribute. Hyrax
                adds this attribute when it replaces placeholder URLs; the DMZ parser does not read it.
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <!-- To be used by the DMR Dataset element (dmrpp:href, dmrpp:trust, dmrpp:version, ...)
         Note that this schema requires namespace qualified attributes because it defines
         information that is added to a DMR document.
         Hyrax deviation: The DMZ parser requires these to _literally_ use 'dmrpp:...'.-->
    <xs:attributeGroup name="DatasetExtensionAttributes">
        <xs:attribute ref="dmrpp:href" use="required" />
        <xs:attribute ref="dmrpp:trust" use="optional" />
        <xs:attribute ref="dmrpp:version" use="optional" />
        <xs:attribute ref="dmrpp:s3" use="optional" />
        <xs:attribute ref="dmrpp:s3credentials" use="optional" />
    </xs:attributeGroup>

    <!-- Qualified attributes that Hyrax injects on 'chunk' (and could inject on 'block') when it replaces
         placeholder URLs. They appear next to the unqualified 'href'. -->
    <xs:attributeGroup name="InjectedLocationAttributes">
        <xs:attribute ref="dmrpp:trust" use="optional" />
        <xs:attribute ref="dmrpp:s3" use="optional" />
        <xs:attribute ref="dmrpp:s3credentials" use="optional" />
    </xs:attributeGroup>

    <!-- ==========
         chunks / chunk / block
         ========== -->

    <xs:complexType name="ChunksType">
        <xs:sequence>
            <!-- Typical element value looks like: 10 10 10 10 -->
            <xs:element ref="dmrpp:chunkDimensionSizes" minOccurs="0" maxOccurs="1" >
                <xs:annotation>
                    <xs:documentation>
                        Sizes of the chunk dimensions, in order. Present for chunked storage. Absent for contiguous
                        storage (one 'chunk' with no 'chunkPositionInArray'). When there are no 'chunk' elements (every
                        value is a fill value) it may be present or absent. Hyrax deviation: if more than one is
                        present, the DMZ parser uses the first in some code paths.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <!-- Either chunks or blocks, never both. There can be neither: then the entire variable is fill values.
                 The block element is used only for HDF4 data. -->
            <xs:choice minOccurs="0">
                <xs:element ref="dmrpp:chunk" minOccurs="1" maxOccurs="unbounded" >
                    <xs:annotation>
                        <xs:documentation>
                            One 'chunk' element per stored chunk. Chunks that are not listed hold only fill values.
                            For contiguous storage there is exactly one 'chunk', with no 'chunkPositionInArray'. When
                            the parent has LBChunk="true", a chunk stored as several linked blocks is written as
                            several consecutive 'chunk' elements (see 'LinkedBlockIndex').
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element ref="dmrpp:block" minOccurs="1" maxOccurs="unbounded" >
                    <xs:annotation>
                        <xs:documentation>
                            One 'block' element per linked block of an HDF4 variable (SDS or Vdata). The blocks are
                            joined in document order to form the variable's data, and the filters, if any, are undone
                            on the joined data. See the 'block' element.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:choice>
        </xs:sequence>

        <xs:attribute name="compressionType" type="dmrpp:FilterList" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    The filters applied to every chunk or block of this variable, e.g., "shuffle deflate", in the order
                    they were applied. To decode the data, apply the inverse filters in reverse order. For example,
                    "shuffle deflate" means the data were first shuffled and then deflated, so to decompress you first
                    inflate and then un-shuffle. When absent, the data are not filtered.

                    Filters:
                    - deflate: zlib compression. May be repeated; repeated deflate filters must be adjacent.
                    - shuffle: HDF5 byte shuffle (uses the element size).
                    - fletcher32: a 4-byte Fletcher-32 checksum appended to the chunk.
                    - lzw: TIFF LZW compression.
                    - tiffpred:P:S:E: TIFF predictor P (2 or 3), S samples per pixel, E elements per row.

                    See also dmrpp:version, whose absence changes how Hyrax treats this list.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="deflateLevel" type="dmrpp:DeflateLevelList" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    Space-separated list of deflate levels for each deflate filter in the 'compressionType' attribute.
                    For example, if 'compressionType' is "shuffle deflate", and the deflate level used was 5, then this
                    attribute would be "5". If there are multiple deflate filters, this lists the levels for each of
                    them in order (e.g., "4 1" for "deflate deflate"). The levels are not needed to decode the data;
                    Hyrax uses them only for its direct I/O optimization.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="fillValue" type="xs:string" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    Value of elements, or whole chunks, that are not stored. The text is interpreted according to the
                    variable's type:
                    - numeric and Enum: a decimal number, e.g., "-9999", "0.000000", "9.96921e+36";
                    - String: the string itself (possibly empty);
                    - Structure: one value per numeric member, in member order, separated by single spaces, with array
                      members expanded element by element, e.g., "-9999.9 32767 999.9".
                    Hyrax deviation: the values "unsupported-string", "unsupported-variable-length-string",
                    "unsupported-array" and "unsupported-compound" mark variables the builder could not handle. Hyrax
                    reports an error for all of them, except that "unsupported-string" on a scalar String or on a
                    fixed-length string array is treated as an empty fill value.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="byteOrder" type="dmrpp:ByteOrder" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    Byte order of the stored data. Valid values are "LE" for little-endian and "BE" for big-endian. If
                    not specified, the default is "LE". It applies to the data referenced by 'chunk' and 'block'.
                    Hyrax deviation: when the attribute is absent, the DMZ parser does no byte swapping (host order),
                    and it never byte-swaps inline data ('compact', 'missingdata', 'specialstructuredata').
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="structOffset" type="dmrpp:StructOffsetList" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    For Structure variables (HDF5 COMPOUND types), a space-separated list of the byte offsets of the
                    members, in member order, followed by the total size of one record in bytes. The first member has
                    offset 0 and is not listed. For example, for a structure with members Float64, Int16, Float32 that
                    the HDF5 library padded to Float64 at 0, Int16 at 8, Float32 at 12 and a record size of 16, this
                    attribute would be "8 12 16". When absent, readers assume the members are packed back to back and
                    the record size is the sum of the member sizes.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="LBChunk" type="xs:boolean" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    For HDF4 data, "true" when at least one chunk of this variable is stored as several linked blocks.
                    In HDF4 some chunks are not atomic: their pieces are stored in different places in the file and
                    must be joined before the chunk is complete and can be decoded. This happens even though the other
                    chunks (usually the majority) are atomic.

                    Each linked block is written as its own 'chunk' element. All blocks of one chunk have the same
                    'chunkPositionInArray', appear one after another in the document, and carry a 'LinkedBlockIndex'
                    of 0, 1, 2, ... Chunks that are not split have no 'LinkedBlockIndex'. A reader joins the blocks of
                    each chunk in index order and then undoes the filters.

                    Hyrax deviation: the DMZ parser treats only the literal value "true" as true.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="DIO" type="dmrpp:DirectIOSetting" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    Direct I/O control. If set to "off", direct I/O should not be used for this variable, even if the
                    server supports it. Direct I/O copies chunks unchanged into a response (Hyrax uses it for netCDF-4
                    responses). When this attribute is absent, direct I/O is allowed.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="ChunkType">
        <xs:attribute name="offset" type="dmrpp:UnsignedLong" use="required" >
            <xs:annotation>
                <xs:documentation>
                    The byte offset of this chunk (or linked block) within the data file.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="nBytes" type="dmrpp:UnsignedLong" use="required" >
            <xs:annotation>
                <xs:documentation>
                    The size in bytes of this chunk (or linked block) as stored, i.e., before the filters are undone.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="chunkPositionInArray" type="dmrpp:ChunkPositionInArrayExpr" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    The position of this chunk in the variable's array, written as the element indices of the chunk's
                    first element: a comma-separated list of non-negative integers surrounded by square brackets, one
                    integer per dimension. Each index is a multiple of the corresponding chunk dimension size. For
                    example, for a 100x100 array chunked in 50x50 element blocks, the four chunks are at "[0,0]",
                    "[0,50]", "[50,0]" and "[50,50]".

                    Present when the parent 'chunks' has 'chunkDimensionSizes' (chunked storage). Absent for contiguous
                    storage.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="fm" type="xs:unsignedInt" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    Filter mask for this chunk, from HDF5. A 32-bit mask in which bit n set to 1 means that the filter at
                    position n of the HDF5 filter pipeline was skipped (not applied) for this chunk. Filters can fail
                    when data are written; this mask records which ones did. When absent, the value is 0: every filter
                    in 'compressionType' was applied. It is also used by direct I/O, since the HDF5 chunk-write API
                    requires it.

                    Hyrax deviation: the DMZ parser uses this value only for direct I/O; it does not use it when
                    decoding chunks.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="href" type="xs:anyURI" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    Optional override of the dataset-level dmrpp:href attribute. If provided, this is the location of
                    the data for this chunk. This allows different chunks to reference data in different files, e.g.,
                    a "missing variables" companion file named "&lt;granule&gt;_mvs.h5".
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="trust" type="xs:boolean" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    Optional override of the dataset-level dmrpp:trust attribute for this chunk's 'href'. Hyrax also
                    accepts the qualified form dmrpp:trust here.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="LinkedBlockIndex" type="xs:unsignedInt" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    For HDF4 data, when this 'chunk' element is one linked block of a chunk that is split into several
                    blocks, the index of this block in the chain. The first block has index 0. All blocks of the chunk
                    share the same 'chunkPositionInArray' and are written consecutively in index order. The parent
                    'chunks' element should have LBChunk="true".

                    Hyrax deviation: XML attribute order is not significant, but the DMZ parser finds this attribute
                    reliably only when it is the last attribute of the element. Producers should write it last.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attributeGroup ref="dmrpp:InjectedLocationAttributes" />
    </xs:complexType>

    <xs:complexType name="BlockType">
        <xs:attribute name="offset" type="dmrpp:UnsignedLong" use="required" />
        <xs:attribute name="nBytes" type="dmrpp:UnsignedLong" use="required" />
        <xs:attribute name="href" type="xs:anyURI" use="optional" />
        <xs:attribute name="trust" type="xs:boolean" use="optional" />
        <xs:attributeGroup ref="dmrpp:InjectedLocationAttributes" />
    </xs:complexType>

    <!-- ==========
         Fixed-length string array marker
         ========== -->

    <xs:complexType name="FixedLengthStringArrayType">
        <xs:attribute name="string_length" type="xs:positiveInteger" use="required" >
            <xs:annotation>
                <xs:documentation>
                    Length of each string in the array, in bytes. For example, if this is 14, then each string in the
                    array is stored in 14 bytes (including padding).
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="pad" type="dmrpp:PadKind" use="optional" default="not_set" >
            <xs:annotation>
                <xs:documentation>
                    How the strings are padded. These follow the HDF5 string padding types: "null_pad" for null
                    character padding, "null_term" for null-terminated strings, "space_pad" for space padding, and
                    "not_set" if the padding kind is not specified. If not specified, the default is "not_set".
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <!-- ==========
         Inline / compact data
         ========== -->

    <xs:simpleType name="CompactDataContents">
        <xs:restriction base="xs:base64Binary" />
    </xs:simpleType>

    <xs:complexType name="CompactType">
        <xs:simpleContent>
            <xs:extension base="dmrpp:CompactDataContents" />
        </xs:simpleContent>
    </xs:complexType>

    <!-- ==========
         Missing-data payload
         ========== -->

    <xs:complexType name="MissingDataType">
        <xs:simpleContent>
            <xs:extension base="xs:base64Binary" />
        </xs:simpleContent>
    </xs:complexType>

    <!-- ==========
         Special structure data payload
         ========== -->

    <xs:complexType name="SpecialStructureDataType">
        <xs:simpleContent>
            <xs:extension base="xs:base64Binary" />
        </xs:simpleContent>
    </xs:complexType>

    <!-- ==========
         Variable-length string array marker/payload
         Example usage:
            <dmrpp:vlsa>
                <v>string1</v>
                <v>string2</v>
                <v c="3">string3</v>          c: run-length count for a repeated value
                <v s="1024">eJwVk0cS...</v>   s: uncompressed size; content is zlib + base64
            </dmrpp:vlsa>
         ========== -->

    <xs:complexType name="VlenStringArrayType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element ref="dmrpp:v" />
            <!-- Hyrax deviation: current documents write 'v' without a prefix. Because a DMR++ declares the DAP4
                 namespace as the default namespace, that 'v' is in the DAP4 namespace. This wildcard accepts it.
                 Its content and attributes are not validated, because DAP4 does not define 'v'. -->
            <xs:any namespace="http://xml.opendap.org/ns/DAP/4.0#" processContents="lax" />
        </xs:choice>
    </xs:complexType>

    <xs:complexType name="VLSASingleValueType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="c" type="dmrpp:UnsignedLong" use="optional" >
                    <xs:annotation>
                        <xs:documentation>
                            The count for run-length encoding (RLE) of repeated values in a variable-length string
                            array. If this attribute is provided, the string value of this element fills this many
                            consecutive elements of the array. If this attribute is not provided, the string value
                            occurs once.
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
                <xs:attribute name="s" type="dmrpp:UnsignedLong" use="optional" >
                    <xs:annotation>
                        <xs:documentation>
                            When present, the content of this element is the zlib-compressed string, base64 encoded, and
                            this attribute is the size of the uncompressed string in bytes. When absent, the content is
                            the string itself. Hyrax compresses strings longer than 512 bytes.
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>


    <!-- ==========
         Global element declarations
         ==========
         These are provided so the main DMR schema can import and reference them
         (e.g., via xs:any or explicit element refs).
         ========== -->

    <xs:element name="chunks" type="dmrpp:ChunksType">
        <xs:annotation>
            <xs:documentation>
                The dmrpp:chunks element describes how one variable's data are stored: its attributes give the filters,
                fill value, byte order and structure layout; its children give the chunk shape and the location of each
                stored chunk or block. It appears at most once, as a child of a DAP4 variable element.

                It is used for both chunked storage (with 'chunkDimensionSizes' and one 'chunk' per stored chunk) and
                contiguous storage (one 'chunk', no 'chunkDimensionSizes'). It may also have no children: then it
                carries only attributes (e.g., 'fillValue') and either the variable's values are given inline by a
                sibling 'compact' or 'specialstructuredata' element, or every value is a fill value.

                This element is in the DMR++ namespace and is normally written as 'dmrpp:chunks'. Hyrax deviation: the
                DMZ parser requires this element to literally use the 'dmrpp:' prefix.
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:element name="chunkDimensionSizes" type="dmrpp:IndexList">
        <xs:annotation>
            <xs:documentation>
                Sizes of the chunk dimensions, in elements, in the same order as the variable's dimensions. For
                example, for a 4D variable chunked in 10x10x10x10 element blocks, this would be "10 10 10 10". For HDF5
                'contiguous' data (data that are not chunked in the HDF5 sense but are stored in one contiguous region),
                this element is omitted.

                This element is in the DMR++ namespace and is normally written as 'dmrpp:chunkDimensionSizes'. Hyrax
                deviation: the DMZ parser requires this element to literally use the 'dmrpp:' prefix.
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:element name="chunk" type="dmrpp:ChunkType" >
        <xs:annotation>
            <xs:documentation>
                The 'chunk' element gives the location of one stored chunk of a variable. Chunks are atomic units of
                storage: a client reads each chunk, undoes the filters (inflate, un-shuffle, etc.), and places the
                result in the array at 'chunkPositionInArray'. Chunks need not be listed in file order. Chunks of a
                chunked variable that are not listed hold only fill values. For contiguous data there is a single
                'chunk' with no 'chunkPositionInArray'. For HDF4 chunks stored as linked blocks, see 'LBChunk' and
                'LinkedBlockIndex'. See the 'block' element for variables stored as linked blocks.

                Hyrax deviation: older DMR++ documents also place a single 'chunk' directly in a variable element,
                without a 'chunks' parent. Hyrax reads it as contiguous storage with no filters and no byte order.

                This element is in the DMR++ namespace and is normally written as 'dmrpp:chunk'. Hyrax deviation: the
                DMZ parser requires this element to literally use the 'dmrpp:' prefix.
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:element name="block" type="dmrpp:BlockType" >
        <xs:annotation>
            <xs:documentation>
                The 'block' element gives the location of one block of an HDF4 variable (an SDS array or a Vdata
                structure) stored as linked blocks, which are not atomic. A client reads all the blocks, joins them in
                document order, and then undoes any filters on the result. See the 'chunk' element, and see 'LBChunk'
                for a chunked variable in which only some chunks are stored as linked blocks.

                Hyrax writes 'block' elements only when there are two or more blocks. Older documents may contain a
                single 'block'; Hyrax still reads them.

                This element is in the DMR++ namespace and is normally written as 'dmrpp:block'. Hyrax deviation: the
                DMZ parser requires this element to literally use the 'dmrpp:' prefix.
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:element name="FixedLengthStringArray" type="dmrpp:FixedLengthStringArrayType" >
        <xs:annotation>
            <xs:documentation>
                The 'FixedLengthStringArray' element marks a String array whose values are stored as fixed-length
                strings, and gives the length and padding of each string. It is empty. It is needed because the DMR
                has no native way to say that a String array is stored as fixed-length strings. The element is used
                with a sibling 'chunks' element (the 'chunk' elements locate the data), with a sibling 'compact'
                element (the data are inline: the strings one after another, each 'string_length' bytes), or both.

                This element is in the DMR++ namespace and is normally written as 'dmrpp:FixedLengthStringArray'. Hyrax
                deviation: the DMZ parser requires this element to literally use the 'dmrpp:' prefix.
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:element name="vlsa" type="dmrpp:VlenStringArrayType" >
        <xs:annotation>
            <xs:documentation>
                The 'vlsa' element holds the values of a String array whose values are variable-length strings. Its
                content is a sequence of 'v' elements in row-major order, each holding one value (or, with the 'c'
                attribute, a run of identical consecutive values). The counts should add up to the number of elements
                in the array.

                This element is in the DMR++ namespace and is normally written as 'dmrpp:vlsa'. Hyrax deviation: the
                DMZ parser requires this element to literally use the 'dmrpp:' prefix.
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:element name="v" type="dmrpp:VLSASingleValueType" >
        <xs:annotation>
            <xs:documentation>
                One value of a 'vlsa' (variable-length string array). See the 'c' and 's' attributes.

                Hyrax deviation: all current documents, and the Hyrax writer, use an unprefixed 'v', which is in the
                DAP4 (default) namespace; the 'vlsa' type accepts that form. The DMZ parser matches the literal name
                'v' and so does not currently read the qualified form 'dmrpp:v' declared here.
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:element name="compact" type="dmrpp:CompactType" >
        <xs:annotation>
            <xs:documentation>
                The 'compact' element holds all of a variable's values, base64 encoded, when the source file used HDF5
                compact storage (the data are kept in the object header and have no file offset of their own). The
                bytes are not compressed:
                - numeric and Enum variables: the values in row-major order;
                - a scalar String: the bytes of the string;
                - a fixed-length String array (with a sibling 'FixedLengthStringArray'): the strings one after
                  another, each 'string_length' bytes.
                Variable-length String arrays, Structure, Sequence and Grid variables are not supported.

                Hyrax deviation: the DMZ parser does not byte-swap these values, even when the sibling 'chunks' has
                'byteOrder'. Current documents hold little-endian values.

                This element is in the DMR++ namespace and is normally written as 'dmrpp:compact'. Hyrax deviation: the
                DMZ parser requires this element to literally use the 'dmrpp:' prefix.
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:element name="missingdata" type="dmrpp:MissingDataType" >
        <xs:annotation>
            <xs:documentation>
                The 'missingdata' element holds the values of a variable that is not stored in the source file. Missing
                data values are (usually) variables that are needed to interpret the data values (e.g., latitude and
                longitude data in some NASA Level 2 data granules, or index values for dimensions that have no
                coordinate variable) but are not included in the original granule. These values were generated by
                API libraries (e.g., HDF-EOS2). Because cloud object stores do not support the use of those APIs, we
                compute the values and supply them in the DMR++.

                Content, by variable type:
                - an array with more than one element: the values in row-major order, zlib compressed, then base64
                  encoded;
                - an array with exactly one element, or a scalar Byte: the raw bytes, base64 encoded, not compressed.
                Other scalar types are not supported.

                Hyrax deviation: the DMZ parser does not byte-swap these values. Current documents hold little-endian
                values.

                This element is in the DMR++ namespace and is normally written as 'dmrpp:missingdata'. Hyrax deviation:
                the DMZ parser requires this element to literally use the 'dmrpp:' prefix.
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:element name="specialstructuredata" type="dmrpp:SpecialStructureDataType" >
        <xs:annotation>
            <xs:documentation>
                The 'specialstructuredata' element holds all values of a Structure variable (an HDF5 COMPOUND, scalar or
                array) that has String members, because such records cannot be read directly from the file. Members
                may be numeric or String, scalar or array; Enum, URI, Opaque and nested constructor members are not
                supported.

                The content is a base64 encoded byte stream. For each structure element in row-major order, and for
                each member in declaration order:
                - a numeric member: its raw bytes, with no padding or separator;
                - a String member: the base64 encoding of the string, followed by ';';
                - a String array member: each element's base64 encoding followed by ';'.

                Hyrax deviation: the DMZ parser does not byte-swap the numeric values and does not support subsetting
                an array of such structures. Current documents hold little-endian values.

                This element is in the DMR++ namespace and is normally written as 'dmrpp:specialstructuredata'. Hyrax
                deviation: the DMZ parser requires this element to literally use the 'dmrpp:' prefix.
            </xs:documentation>
        </xs:annotation>
    </xs:element>

</xs:schema>
