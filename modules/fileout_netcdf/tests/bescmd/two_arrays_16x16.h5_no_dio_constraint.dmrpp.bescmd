<?xml version="1.0" encoding="UTF-8"?>
<request reqID="some_unique_value" reqUUID="SomeUUIDString">
    <setContext name="dap_format">dap4</setContext>
    <setContainer name="data" space="catalog">/data/two_arrays_16x16.h5_no_dio.dmrpp</setContainer>
    <define name="d">
	<container name="data" >
           <dap4constraint>float_data[1:1:1][2:1:3];uint16_data[1:1:1][0:2:3]</dap4constraint>
        </container>
    </define>
    <get type="dap" definition="d" returnAs="netcdf-4"/>
</request>
