<?xml version="1.0" encoding="UTF-8"?>
<bes:request xmlns:bes="http://xml.opendap.org/ns/bes/1.0#" reqID="[http-8080-1:27:bes_request]">
  <bes:setContext name="dap4_checksums">true</bes:setContext>
  <bes:setContext name="xdap_accept">4.0</bes:setContext>
  <bes:setContext name="dap_explicit_containers">no</bes:setContext>
  <bes:setContext name="errors">xml</bes:setContext>
  <bes:setContext name="max_response_size">0</bes:setContext>
  
  <bes:setContainer name="c" space="catalog">/data/special_fixed_str.h5.dmrpp</bes:setContainer>
  
  <bes:define name="d1" space="default">
    <bes:container name="c">
        <bes:dap4constraint>One_chunk_unlimited[0:2:2][1:1:2];One_chunk_unlimited_comp[0:2:2][1:1:2];More_null_term_cont_str[1:1:2][0:2:2]; More_null_term_chunk_comp_str[1:1:2][0:2:2]</bes:dap4constraint>
    </bes:container>
  </bes:define>
  
  <bes:get type="dap" definition="d1" returnAs="netcdf-4" />
  
</bes:request>
