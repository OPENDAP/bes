group: inr_input {

  group: ephemeris {
    dimensions:
    	ephemeris_time = UNLIMITED ; // (37 currently)
    variables:
    	double ephemeris_time(ephemeris_time) ;
    		ephemeris_time:units = "seconds since removed date-time" ;
    	double satellite_Z(ephemeris_time) ;
    		satellite_Z:units = "km" ;
    		satellite_Z:long_name = "Satellite Z coordinate" ;
    		satellite_Z:comment = "Earth-centered WGS84 Cartesian coordinates (z=North Pole, y=equator, x=prime meridian)" ;
