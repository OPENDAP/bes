    		satellite_velocity_Y:units = "km/s" ;
    		satellite_velocity_Y:long_name = "Satellite Y velocity" ;
    		satellite_velocity_Y:comment = "Velocity component in instantaneous non-rotating Earth-centered WGS84 Cartesian coordinates (z=North Pole, y=equator, x=prime meridian)" ;
    	double satellite_Y(ephemeris_time) ;
    		satellite_Y:units = "km" ;
    		satellite_Y:long_name = "Satellite Y coordinate" ;
    		satellite_Y:comment = "Earth-centered WGS84 Cartesian coordinates (z=North Pole, y=equator, x=prime meridian)" ;
    	double satellite_velocity_X(ephemeris_time) ;
    		satellite_velocity_X:units = "km/s" ;
    		satellite_velocity_X:long_name = "Satellite X velocity" ;
    		satellite_velocity_X:comment = "Velocity component in instantaneous non-rotating Earth-centered WGS84 Cartesian coordinates (z=North Pole, y=equator, x=prime meridian)" ;
    	double satellite_X(ephemeris_time) ;
    		satellite_X:units = "km" ;
    		satellite_X:long_name = "Satellite X coordinate" ;
    		satellite_X:comment = "Earth-centered WGS84 Cartesian coordinates (z=North Pole, y=equator, x=prime meridian)" ;
    	double satellite_velocity_Z(ephemeris_time) ;
    		satellite_velocity_Z:units = "km/s" ;
    		satellite_velocity_Z:long_name = "Satellite Z velocity" ;
    		satellite_velocity_Z:comment = "Velocity component in instantaneous non-rotating Earth-centered WGS84 Cartesian coordinates (z=North Pole, y=equator, x=prime meridian)" ;

    // group attributes:
    		:DODS_EXTRA.Unlimited_Dimension = "ephemeris_time" ;
    		:source = "GPSR" ;
    } // group ephemeris

  group: telemetry {

    group: gyroscope {
      dimensions:
      	gyro_time = UNLIMITED ; // (42690 currently)
      	gyro_axis = 4 ;
      	bias_time = UNLIMITED ; // (48 currently)
      	bias_axis = 3 ;
      variables:
      	double gyro_time(gyro_time) ;
      		gyro_time:units = "seconds since removed date-time" ;
      	double bias_time(bias_time) ;
      		bias_time:units = "seconds since removed date-time" ;
      	ushort gyro_quality_flag(gyro_time, gyro_axis) ;
      		gyro_quality_flag:comment = "Gyro data quality flags" ;
      		gyro_quality_flag:flag_meanings = "invalid saturated" ;
      		gyro_quality_flag:flag_masks = 1US, 2US ;
      	int gyro_output(gyro_time, gyro_axis) ;
      		gyro_output:units = "counts" ;
      		gyro_output:comment = "Raw gyro output in telemetry counts" ;
      	float gyro_bias(bias_time, bias_axis) ;
      		gyro_bias:units = "radian/s" ;
      		gyro_bias:comment = "Gyro bias estimate resolved along spacecraft body axes" ;

      // group attributes:
      		:DODS_EXTRA.Unlimited_Dimension = "gyro_time\nbias_time" ;
      } // group gyroscope

    group: mirror {
      dimensions:
      	sma_time = UNLIMITED ; // (43141 currently)
      variables:
      	double sma_time(sma_time) ;
      		sma_time:units = "seconds since removed date-time" ;
      	float proc_meas_x(sma_time) ;
      		proc_meas_x:units = "microradians" ;
      		proc_meas_x:comment = "Filtered estimated control axis-x scan position" ;
      	float proc_meas_y(sma_time) ;
      		proc_meas_y:units = "microradians" ;
      		proc_meas_y:comment = "Filtered estimated control axis-y scan position" ;
      	float dit_raw_x(sma_time) ;
      		dit_raw_x:units = "counts" ;
      		dit_raw_x:comment = "Filtered raw DIT readout for sensor axis-x DIT pair" ;
      	float dit_raw_y(sma_time) ;
      		dit_raw_y:units = "counts" ;
      		dit_raw_y:comment = "Filtered raw DIT readout for sensor axis-y DIT pair" ;

      // group attributes:
      		:DODS_EXTRA.Unlimited_Dimension = "sma_time" ;
      } // group mirror
    } // group telemetry
  } // group inr_input

group: geometry {
  variables:
  	double satellite_X(mirror_step) ;
  		satellite_X:units = "km" ;
  		satellite_X:long_name = "satellite X coordinate at exposure start" ;
  		satellite_X:comment = "Earth-centered WGS84 Cartesian coordinates (z=North Pole, y=equator, x=prime meridian)" ;
  	double boresight2(mirror_step) ;
  		boresight2:units = "" ;
  		boresight2:long_name = "Boresight unit vector component along GN&C pitch axis" ;
  		boresight2:comment = "Boresight unit vector component along GN&C pitch axis" ;
  	double sun_angle(mirror_step) ;
  		sun_angle:units = "radians" ;
  		sun_angle:long_name = "Sun cone angle from boresight" ;
  		sun_angle:comment = "Angle between the sun and the boresight of the instrument at the exposure start" ;
  	double sun_X(mirror_step) ;
  		sun_X:units = "km" ;
  		sun_X:long_name = "Sun X coordinate at exposure start" ;
  		sun_X:comment = "Earth-centered WGS84 Cartesian coordinates (z=North Pole, y=equator, x=prime meridian)" ;
  	double satellite_Y(mirror_step) ;
  		satellite_Y:units = "km" ;
  		satellite_Y:long_name = "satellite Y coordinate at exposure start" ;
  		satellite_Y:comment = "Earth-centered WGS84 Cartesian coordinates (z=North Pole, y=equator, x=prime meridian)" ;
  	double satellite_Z(mirror_step) ;
  		satellite_Z:units = "km" ;
  		satellite_Z:long_name = "satellite Z coordinate at exposure start" ;
  		satellite_Z:comment = "Earth-centered WGS84 Cartesian coordinates (z=North Pole, y=equator, x=prime meridian)" ;
  	double sun_Y(mirror_step) ;
  		sun_Y:units = "km" ;
  		sun_Y:long_name = "Sun Y coordinate at exposure start" ;
  		sun_Y:comment = "Earth-centered WGS84 Cartesian coordinates (z=North Pole, y=equator, x=prime meridian)" ;
  	double moon_X(mirror_step) ;
  		moon_X:units = "km" ;
  		moon_X:long_name = "Moon X coordinate at exposure start" ;
  		moon_X:comment = "Earth-centered WGS84 Cartesian coordinates (z=North Pole, y=equator, x=prime meridian)" ;
  	double boresight3(mirror_step) ;
  		boresight3:units = "" ;
  		boresight3:long_name = "Boresight unit vector component along GN&C yaw axis" ;
  		boresight3:comment = "Boresight unit vector component along GN&C yaw axis" ;
  	double boresight1(mirror_step) ;
  		boresight1:units = "" ;
  		boresight1:long_name = "Boresight unit vector component along GN&C roll axis" ;
  		boresight1:comment = "Boresight unit vector component along GN&C roll axis" ;
  	double sun_Z(mirror_step) ;
  		sun_Z:units = "km" ;
  		sun_Z:long_name = "Sun Z coordinate at exposure start" ;
  		sun_Z:comment = "Earth-centered WGS84 Cartesian coordinates (z=North Pole, y=equator, x=prime meridian)" ;
  	double moon_Y(mirror_step) ;
  		moon_Y:units = "km" ;
  		moon_Y:long_name = "Moon Y coordinate at exposure start" ;
  		moon_Y:comment = "Earth-centered WGS84 Cartesian coordinates (z=North Pole, y=equator, x=prime meridian)" ;
  	double moon_Z(mirror_step) ;
  		moon_Z:units = "km" ;
  		moon_Z:long_name = "Moon Z coordinate at exposure start" ;
  		moon_Z:comment = "Earth-centered WGS84 Cartesian coordinates (z=North Pole, y=equator, x=prime meridian)" ;
  } // group geometry
}
