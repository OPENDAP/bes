<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<request reqID="some_unique_value">
    <setContext name="dap4_checksums">true</setContext>
    <setContext name="dap_format">dap2</setContext>
    <setContext name="xdap_accept">3.3</setContext>
    <setContainer name="c" space="catalog">/data/daymet_v4_swe_monavg_pr_2024.tif</setContainer>
    <define name="d">
        <container name="c"/>
    </define>
    <get type="dmr" definition="d"/>
</request>